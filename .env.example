# Copy to .env.local (never commit real values).

# Public URL of the site (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL="https://example.com"

# Zipline (image hosting for the backoffice uploads). Server-side only.
ZIPLINE_URL="https://your-zipline-instance"
ZIPLINE_TOKEN=""
# Optional: id of a Zipline folder to group the backoffice uploads.
ZIPLINE_FOLDER_ID=""
# Optional: id of a Zipline folder for the static site media (npm run media:upload).
ZIPLINE_MEDIA_FOLDER_ID=""

# Backoffice (/admin)
ADMIN_PASSWORD="password123"
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
ADMIN_SESSION_SECRET="MTc5NTAzODAyOTMzNg==.YzIwNTk4MmJjMDU0ZWNmZTBjZDRkMWU4LmQzZGEyOWRiZTE0MTBlM2U4NzZjNjk5OTg1MDYwOGQyNGJjNjJhZmNmZGU0YmExYzFmNDk4Y2FiMDkwYTExYWRlOWY3ZjUzMTgzOTkwMzZiOTgzOWYyODMyMTU4OTJmNGUxMzJmNjAzMzRjM2Y3YjM2ZDk4ZjE3ZTI5NDA1MTBkMmMuYjZiODI0ZmU1YTRjN2Y2ZTIyZWI0NTVjMzQ5MDU3OTM="

# Postgres database for the backoffice projects. Create the tables with `npm run db:migrate`.
DATABASE_URL="postgres://user:password@localhost:5432/studio_cabines"
